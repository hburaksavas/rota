{
  "name": "rota-po",
  "productName": "Rota",
  "version": "0.1.0",
  "private": true,
  "description": "PO workbench for banking software backlogs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:renderer": "tsc -p tsconfig.renderer.json && esbuild src/app.ts --bundle --format=iife --platform=browser --target=es2022 --outfile=dist/renderer/app.js",
    "build": "npm run build:renderer",
    "test:acceptance": "npm run build && node tests/acceptance/uat.mjs",
    "start": "npm run build:renderer && node scripts/start-node-webview.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@antv/x6": "^3.1.8",
    "@kenjiuno/msgreader": "^1.29.0",
    "@napi-rs/keyring": "^2.1.2",
    "@webviewjs/webview": "^0.4.9",
    "exceljs": "^4.4.0",
    "koffi": "^3.3.3",
    "mailparser": "^3.12.4",
    "tslib": "^2.8.1"
  }
}
